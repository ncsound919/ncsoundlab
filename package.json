    "bravoh-loudness": "^0.1.0",
    "dexie": "^4.4.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "meyda": "^5.6.3",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-piano": "^3.1.3",
    "tonal": "^6.4.3",
    "tone": "^15.1.22",
