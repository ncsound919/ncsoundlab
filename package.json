{
  "name": "nc-soundlab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NC Tar Heel Sound Lab — a web-based beatmaker and sound design workstation.",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs');for(const p of ['dist']){try{fs.rmSync(p,{recursive:true,force:true});}catch{}}\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
